# 物流研究助手 Research-Agent 环境变量模板
# 复制为 .env 后填入实际值（Windows: copy .env.example .env）
#
# 启动顺序：履约知识助手 :8001 → 仓配自助问数 :8010 → 物流研究助手 :8000（一键起后两者：python scripts/dev.py）
# 两个依赖服务不可达也能跑，只是对应那一路会按降级路径标记缺失。

# ---------- LLM ----------
# 主链路（规划 / 汇聚 / 审查 / 生成）用能力更强的模型
LLM_MODEL_NAME=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填入百炼 API Key
LLM_TIMEOUT=120
# 评测默认走便宜的模型：全量跑一次是几百到上千次调用，价差会被放大
LLM_EVAL_MODEL_NAME=qwen-flash

# ---------- 工具一：联网搜索（百炼 MCP WebSearch）----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_API_KEY=请填入百炼 API Key（可与 LLM_API_KEY 相同）
WEB_SEARCH_COUNT=5
WEB_SEARCH_TIMEOUT=15

# ---------- 工具二：内部知识库（复用履约知识助手的检索服务）----------
# 履约知识助手 Warehouse-KB 的检索服务地址（:8001），需先启动履约知识助手
KB_SERVICE_URL=http://localhost:8001
KB_SERVICE_TIMEOUT=60
KB_TOP_K=8

# ---------- 工具三：结构化数据（复用仓配自助问数的问数服务）----------
# 仓配自助问数 LogiQL 的服务地址（:8010），需先启动仓配自助问数
ZHISHU_SERVICE_URL=http://localhost:8010
ZHISHU_SERVICE_TIMEOUT=180
# 单次查询返回行数上限，防止把整张表捞进上下文
SQL_MAX_ROWS=200

# ---------- 运行参数 ----------
# 会话工作区根目录（每个会话一个子目录，报告与中间产物落在这里）
WORKSPACE_ROOT=output
# 守卫阈值
GUARD_MAX_STEPS=30
GUARD_MAX_TOKENS=120000
# 审查回环最大轮数（有界，防止无限补检索）
REVIEW_MAX_ROUNDS=2

# 报告生成前的人工确认（Web 端生效；CLI 强制关闭）
HITL_ENABLED=true
# 等待用户确认的秒数，超时按「确认」继续
HITL_TIMEOUT=600
